# ==============================================================================
# CareerLens AI - Server Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# WARNING: NEVER commit your real '.env' file or expose API keys publicly.
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Primary AI Provider: Google Gemini API (Recommended)
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Alternative AI Provider: OpenAI API (Optional)
# If OPENAI_API_KEY is provided and GEMINI_API_KEY is unset, OpenAI will be used.
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Request timeout in milliseconds (Default: 45000ms / 45s)
AI_TIMEOUT_MS=45000
